# AEMET OpenData API key (get it at https://opendata.aemet.es with a PERSONAL email).
AEMET_API_KEY=your_personal_api_key_here
# Optional overrides:
AEMET_BASE_URL=https://opendata.aemet.es/opendata
STATION_TIMEZONE=Antarctica/Palmer
OUTPUT_TIMEZONE=Europe/Madrid
DATABASE_URL=sqlite:///./aemet_cache.db
REQUEST_TIMEOUT=30
